<?xml version="1.0" ?>

<robot name="motoman_gp12" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:include filename="$(find gp_12_trail)/urdf/gp12_macro.xacro" />
    <xacro:include filename="$(find gp_12_trail)/urdf/robotiq_2f_140.xacro" />

    <xacro:motoman_gp12 prefix=""/>

    <!-- attach gripper -->
    <xacro:robotiq_2f_140 parent="tool0" tf_prefix="">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:robotiq_2f_140>
</robot>